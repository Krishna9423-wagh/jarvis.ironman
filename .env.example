# J.A.R.V.I.S. Environment Configuration
# ===================================================================
# Copy this file to .env or .env.local and fill in your keys:
# cp .env.example .env

# Anthropic Claude API Key (for LLM reasoning & function calling)
ANTHROPIC_API_KEY=your_claude_api_key_here

# Optional: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Orchestration Model (defaults to claude-3-5-sonnet-20241022)
JARVIS_MODEL=claude-3-5-sonnet-20241022

# Preferred macOS Voice (e.g. Daniel for UK English, Samantha, Alex)
JARVIS_VOICE=Daniel

# Wake word (default: jarvis)
JARVIS_WAKE_WORD=jarvis
